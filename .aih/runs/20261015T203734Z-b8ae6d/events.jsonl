{"advisories": [{"file": "caddytest/integration/stream_detached_test.go", "line": 0, "pass": 2, "severity": "advisory", "text": "No integration test covers an h2 extended CONNECT stream with stream_detached across a reload, or detached streams with stream_close_delay set. The doc comment says the delay does not apply and that h2 streams keep the request."}, {"file": "modules/caddyhttp/reverseproxy/streaming.go", "line": 520, "pass": 2, "severity": "advisory", "text": "A stream whose upgrade finishes after the old handler's Cleanup has run is registered too late and is never closed on removal of its upstream. No test covers this reload race."}, {"file": "modules/caddyhttp/reverseproxy/stream_detached_test.go", "line": 0, "pass": 2, "severity": "advisory", "text": "No end-to-end test for stream_timeout expiring on a detached stream, or for stream_logs with JSON config. Both are covered only at unit level."}, {"file": "modules/caddyhttp/reverseproxy/streaming.go", "line": 538, "pass": 4, "severity": "advisory", "text": "streamRegistry.count is used only by tests."}, {"file": "modules/caddyhttp/intercept/intercept.go", "line": 0, "pass": 4, "severity": "advisory", "text": "intercept.go is declared for the task but unchanged. The intercept 101 handling relies entirely on the responseRecorder change, so the declaration is unused."}], "at": "2026-10-15T21:03:39+00:00", "attempt": 1, "event": "GateEvaluated", "failures": [], "gate": "review.approved", "passed": true, "run_id": "20261015T203734Z-b8ae6d", "schema_version": 1, "task": "T1", "verdict": "approve"}
