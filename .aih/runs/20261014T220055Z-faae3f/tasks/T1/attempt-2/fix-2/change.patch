+	tn2 := openTunnel(t, "/ws", "echo")
+	tn2.echo(t, "second")
+	tester.InitServer(streamCaddyfile(3, fmt.Sprintf("log {\n\t\toutput file %s\n\t\tformat json\n\t\tlevel DEBUG\n\t}\n\trespond \"gone\"", logPath)), "caddyfile")
+	tn2.waitClosed(t, streamWait)
