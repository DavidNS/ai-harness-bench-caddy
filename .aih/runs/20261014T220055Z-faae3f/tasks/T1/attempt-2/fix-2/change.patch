+// StreamLogs configures the logging of upgraded streams, such as
+// WebSockets. When the server has access logging enabled, a log entry
+// is written to the access logger when a stream is closed.
+type StreamLogs struct {
+	// If true, the access log entry of the request that upgraded to
+	// a stream (the handshake) is not written. Stream close logs are
+	// not affected. Default: the handshake is logged.
+	SkipHandshake bool `json:"skip_handshake,omitempty"`
+
+	// The level of the stream close log entries: debug, info, warn
+	// or error. Default: debug.
+	Level string `json:"level,omitempty"`
+}
+
+// Results with which a stream can end.
+const (
+	streamResultCompleted = "completed" // both directions ended cleanly
+	streamResultError     = "error"     // a copy failed, e.g. a peer went away
+	streamResultTimeout   = "timeout"   // stream_timeout elapsed
+	streamResultClosed    = "closed"    // closed by a config reload or shutdown
+)
+
+// streamAccounting accounts for a single upgraded stream in the stream
+// metrics. However many paths try to end the stream, it is counted once.
+type streamAccounting struct {
+	start        time.Time
+	toBackend    atomic.Int64
+	fromBackend  atomic.Int64
+	mu           sync.Mutex
+	result       string
+	finishedOnce sync.Once
+}
+
+// newStreamAccounting starts accounting for a stream that was just established.
+func newStreamAccounting() *streamAccounting {
+	streamMetrics.active.Inc()
+	return &streamAccounting{start: time.Now()}
+}
+
+// setResult records why the stream is ending. Only the first
+// result is kept, so the cause of the end wins over its effects.
+func (s *streamAccounting) setResult(result string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.result == "" {
+		s.result = result
+	}
+}
+
+// finish ends the accounting of the stream, using result unless an earlier
+// one was recorded with setResult. Only the first call has an effect: it
+// updates the metrics and reports true along with the final result.
+func (s *streamAccounting) finish(result string) (string, bool) {
+	var first bool
+	s.finishedOnce.Do(func() {
+		first = true
+		s.setResult(result)
+		s.mu.Lock()
+		result = s.result
+		s.mu.Unlock()
+
+		streamMetrics.active.Dec()
+		streamMetrics.closed.WithLabelValues(result).Inc()
+		streamMetrics.duration.Observe(time.Since(s.start).Seconds())
+		streamMetrics.bytes.WithLabelValues("to_backend").Add(float64(s.toBackend.Load()))
+		streamMetrics.bytes.WithLabelValues("from_backend").Add(float64(s.fromBackend.Load()))
+	})
+	if !first {
+		return "", false
+	}
+	return result, true
+}
+
+// streamRegistry tracks the upgraded streams that are detached from the
+// lifecycle of the config that created them (stream_detached), as well as
+// the upstreams of the handlers that are currently live. A detached stream
+// stays open until its upstream is no longer live.
+type streamRegistry struct {
+	mu      sync.Mutex
+	live    map[string]int // upstream -> number of live handlers using it
+	streams map[*detachedStream]struct{}
+}
+
+type detachedStream struct {
+	upstream string
+	dynamic  bool
+	close    func() error
+}
+
+// dynamicLiveKey marks a live handler whose upstreams are only known when
+// requests are served (dynamic upstreams, or placeholders in a dial address).
+// Streams started by such handlers stay open while any such handler is live.
+const dynamicLiveKey = "\x00dynamic"
+
+// detachedStreams is shared by all handlers, since the handlers of an old
+// config are cleaned up while the streams they started are still running.
+var detachedStreams = newStreamRegistry()
+
+func newStreamRegistry() *streamRegistry {
+	return &streamRegistry{
+		live:    make(map[string]int),
+		streams: make(map[*detachedStream]struct{}),
+	}
+}
+
+// addLive marks the upstreams as used by a live handler.
+func (r *streamRegistry) addLive(upstreams []string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for _, u := range upstreams {
+		r.live[u]++
+	}
+}
+
+// removeLive marks the upstreams as no longer used by a handler.
+func (r *streamRegistry) removeLive(upstreams []string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for _, u := range upstreams {
+		if r.live[u] <= 1 {
+			delete(r.live, u)
+			continue
+		}
+		r.live[u]--
+	}
+}
+
+// add registers a stream to upstream that is closed with closeFn when the
+// upstream is no longer live. It returns a function that unregisters the
+// stream, or false if the upstream is not live anymore, in which case the
+// stream was not registered and must be closed by the caller.
+func (r *streamRegistry) add(upstream string, closeFn func() error) (remove func(), ok bool) {
+	return r.addStream(upstream, false, closeFn)
+}
+
+// addStream is like add. A dynamic stream, started by a handler whose upstreams
+// are not known up front, is also kept while a dynamic handler is live.
+func (r *streamRegistry) addStream(upstream string, dynamic bool, closeFn func() error) (remove func(), ok bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if !r.isLive(upstream, dynamic) {
+		return nil, false
+	}
+	ds := &detachedStream{upstream: upstream, dynamic: dynamic, close: closeFn}
+	r.streams[ds] = struct{}{}
+	return func() {
+		r.mu.Lock()
+		delete(r.streams, ds)
+		r.mu.Unlock()
+	}, true
+}
+
+// closeOrphaned closes the streams whose upstream is not live anymore,
+// and returns the first error encountered. The streams to retained
+// upstreams are left alone.
+func (r *streamRegistry) closeOrphaned() error {
+	r.mu.Lock()
+	var orphaned []*detachedStream
+	for ds := range r.streams {
+		if !r.isLive(ds.upstream, ds.dynamic) {
+			orphaned = append(orphaned, ds)
+			delete(r.streams, ds)
+		}
+	}
+	r.mu.Unlock()
+
+	// closing may block (graceful close writes to the connections), so don't hold the lock
+	var err error
+	for _, ds := range orphaned {
+		if closeErr := ds.close(); closeErr != nil && err == nil {
+			err = closeErr
+		}
+	}
+	return err
+}
+
+// isLive reports whether a stream to upstream may stay open. The lock must be held.
+func (r *streamRegistry) isLive(upstream string, dynamic bool) bool {
+	return r.live[upstream] > 0 || (dynamic && r.live[dynamicLiveKey] > 0)
+}
+
+// count returns the number of registered streams.
+func (r *streamRegistry) count() int {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return len(r.streams)
+}
diff --git a/modules/caddyhttp/reverseproxy/streams_test.go b/modules/caddyhttp/reverseproxy/streams_test.go
new file mode 100644
index 00000000..681ba8a5
--- /dev/null
+++ b/modules/caddyhttp/reverseproxy/streams_test.go
@@ -0,0 +1,196 @@
+package reverseproxy
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+// TestStreamRegistry runs the registry scenarios: live upstream counting,
+// registration, and closing only the streams whose upstream is gone.
+func TestStreamRegistry(t *testing.T) {
+	t.Run("live counting", TestStreamRegistryLiveCounting)
+	t.Run("add requires live upstream", TestStreamRegistryAddRequiresLiveUpstream)
+	t.Run("close orphaned", TestStreamRegistryCloseOrphaned)
+	t.Run("first error", TestStreamRegistryCloseOrphanedReportsFirstError)
+	t.Run("concurrent", TestStreamRegistryConcurrent)
+}
+
+func TestStreamRegistryLiveCounting(t *testing.T) {
+	r := newStreamRegistry()
+
+	r.addLive([]string{"a:1", "b:2"})
+	r.addLive([]string{"a:1"})
+	if got := r.live["a:1"]; got != 2 {
+		t.Fatalf("live[a:1] = %d, want 2", got)
+	}
+
+	// one of two handlers using the upstream went away
+	r.removeLive([]string{"a:1"})
+	if got := r.live["a:1"]; got != 1 {
+		t.Fatalf("live[a:1] = %d, want 1", got)
+	}
+
+	// the last ones went away
+	r.removeLive([]string{"a:1", "b:2"})
+	if len(r.live) != 0 {
+		t.Fatalf("live = %v, want empty", r.live)
+	}
+
+	// removing what is not live is harmless
+	r.removeLive([]string{"c:3"})
+	if len(r.live) != 0 {
+		t.Fatalf("live = %v, want empty", r.live)
+	}
+}
+
+func TestStreamRegistryAddRequiresLiveUpstream(t *testing.T) {
+	r := newStreamRegistry()
+
+	if remove, ok := r.add("a:1", func() error { return nil }); ok || remove != nil {
+		t.Fatal("add() registered a stream to an upstream that is not live")
+	}
+	if got := r.count(); got != 0 {
+		t.Fatalf("count() = %d, want 0", got)
+	}
+
+	r.addLive([]string{"a:1"})
+	remove, ok := r.add("a:1", func() error { return nil })
+	if !ok {
+		t.Fatal("add() refused a stream to a live upstream")
+	}
+	if got := r.count(); got != 1 {
+		t.Fatalf("count() = %d, want 1", got)
+	}
+	remove()
+	if got := r.count(); got != 0 {
+		t.Fatalf("count() after remove = %d, want 0", got)
+	}
+}
+
+func TestStreamRegistryCloseOrphaned(t *testing.T) {
+	r := newStreamRegistry()
+	r.addLive([]string{"kept:1", "gone:2"})
+
+	var keptClosed, goneClosed atomic.Int32
+	if _, ok := r.add("kept:1", func() error { keptClosed.Add(1); return nil }); !ok {
+		t.Fatal("add(kept) failed")
+	}
+	if _, ok := r.add("gone:2", func() error { goneClosed.Add(1); return nil }); !ok {
+		t.Fatal("add(gone) failed")
+	}
+	if _, ok := r.add("gone:2", func() error { goneClosed.Add(1); return nil }); !ok {
+		t.Fatal("add(gone) failed")
+	}
+
+	// nothing is orphaned yet
+	if err := r.closeOrphaned(); err != nil {
+		t.Fatalf("closeOrphaned() = %v", err)
+	}
+	if keptClosed.Load() != 0 || goneClosed.Load() != 0 {
+		t.Fatal("closeOrphaned() closed streams whose upstream is still live")
+	}
+
+	// the new config no longer has gone:2
+	r.removeLive([]string{"gone:2"})
+	if err := r.closeOrphaned(); err != nil {
+		t.Fatalf("closeOrphaned() = %v", err)
+	}
+	if got := goneClosed.Load(); got != 2 {
+		t.Fatalf("streams to the removed upstream closed = %d, want 2", got)
+	}
+	if got := keptClosed.Load(); got != 0 {
+		t.Fatalf("stream to the retained upstream closed = %d, want 0", got)
+	}
+	if got := r.count(); got != 1 {
+		t.Fatalf("count() = %d, want 1", got)
+	}
+
+	// closing again must not close the same streams twice
+	if err := r.closeOrphaned(); err != nil {
+		t.Fatalf("closeOrphaned() = %v", err)
+	}
+	if got := goneClosed.Load(); got != 2 {
+		t.Fatalf("streams closed twice: %d", got)
+	}
+}
+
+func TestStreamRegistryCloseOrphanedReportsFirstError(t *testing.T) {
+	r := newStreamRegistry()
+	r.addLive([]string{"a:1"})
+
+	first := errors.New("first")
+	var closed atomic.Int32
+	// both fail: the error of whichever runs first is kept, and all are closed
+	for range 2 {
+		if _, ok := r.add("a:1", func() error { closed.Add(1); return first }); !ok {
+			t.Fatal("add() failed")
+		}
+	}
+	r.removeLive([]string{"a:1"})
+
+	if err := r.closeOrphaned(); !errors.Is(err, first) {
+		t.Fatalf("closeOrphaned() = %v, want %v", err, first)
+	}
+	if got := closed.Load(); got != 2 {
+		t.Fatalf("closed = %d, want 2 (an error must not stop the others)", got)
+	}
+}
+
+// Streams of handlers with dynamic upstreams can't be matched to a static
+// upstream; they stay while a dynamic handler is live.
+func TestStreamRegistryDynamicStreams(t *testing.T) {
+	r := newStreamRegistry()
+
+	// no dynamic handler: refused, like any upstream that is not live
+	if _, ok := r.addStream("dyn:1", true, func() error { return nil }); ok {
+		t.Fatal("a dynamic stream was registered without a live dynamic handler")
+	}
+
+	r.addLive([]string{dynamicLiveKey})
+	var closed, staticClosed atomic.Int32
+	if _, ok := r.addStream("dyn:1", true, func() error { closed.Add(1); return nil }); !ok {
+		t.Fatal("a dynamic stream was refused although a dynamic handler is live")
+	}
+	// a static stream to an address that is not live is not helped by the dynamic handler
+	if _, ok := r.addStream("dyn:1", false, func() error { staticClosed.Add(1); return nil }); ok {
+		t.Fatal("a static stream was registered to an upstream that is not live")
+	}
+
+	// a reload keeps a dynamic handler
+	r.addLive([]string{dynamicLiveKey})
+	r.removeLive([]string{dynamicLiveKey})
+	if err := r.closeOrphaned(); err != nil || closed.Load() != 0 {
+		t.Fatalf("closeOrphaned() = %v, closed = %d; want the dynamic stream kept", err, closed.Load())
+	}
+
+	// the last dynamic handler is gone
+	r.removeLive([]string{dynamicLiveKey})
+	if err := r.closeOrphaned(); err != nil || closed.Load() != 1 {
+		t.Fatalf("closeOrphaned() = %v, closed = %d; want the dynamic stream closed", err, closed.Load())
+	}
+}
+
+func TestStreamRegistryConcurrent(t *testing.T) {
+	r := newStreamRegistry()
+	r.addLive([]string{"a:1"})
+
+	var wg sync.WaitGroup
+	for range 20 {
+		wg.Go(func() {
+			if remove, ok := r.add("a:1", func() error { return nil }); ok {
+				remove()
+			}
+		})
+	}
+	wg.Go(func() {
+		r.removeLive([]string{"a:1"})
+		_ = r.closeOrphaned()
+	})
+	wg.Wait()
+
+	if got := r.count(); got != 0 {
+		t.Fatalf("count() = %d, want 0", got)
+	}
+}
