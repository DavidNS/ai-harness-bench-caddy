+func TestDetachedStreamAccessLog(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		skipHandshake bool
+	}{
+		{name: "handshake logged", skipHandshake: false},
+		{name: "handshake skipped", skipHandshake: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			startWSBackend(t, 9101)
+			tester := caddytest.NewTester(t)
+			logPath := filepath.ToSlash(filepath.Join(t.TempDir(), "access.log"))
+
+			skip := ""
+			if tc.skipHandshake {
+				skip = "skip_handshake"
+			}
+			site := func(gen int) string {
+				return streamSite(gen, fmt.Sprintf(`	log access {
+		output file %s
+		format json
+		level INFO
+	}
+	reverse_proxy 127.0.0.1:9101 {
+		stream_detached
+		stream_logs {
+			%s
+			level info
+		}
+	}`, logPath, skip))
+			}
+
+			tester.InitServer(site(1), "caddyfile")
+			c, _ := dialWS(t, "/ws", nil)
+			c.echo(t, "hello")
+			c.echo(t, "again!!")
+
+			// reload while the stream is open: it outlives the config it started with
+			tester.InitServer(site(2), "caddyfile")
+			c.echo(t, "after reload")
+			c.Close()
+
+			closed := waitForLogEntry(t, logPath, isStreamClosedEntry)
+			if logger, _ := closed["logger"].(string); !strings.HasPrefix(logger, "http.log.access") {
+				t.Errorf("stream close logged by %q, want an access logger", logger)
+			}
+			if closed["level"] != "info" {
+				t.Errorf("stream close logged at %v, want info", closed["level"])
+			}
+			if closed["upstream"] != "127.0.0.1:9101" {
+				t.Errorf("upstream = %v, want 127.0.0.1:9101", closed["upstream"])
+			}
+			const total = len("hello") + len("again!!") + len("after reload")
+			if closed["bytes_to_backend"] != float64(total) || closed["bytes_from_backend"] != float64(total) {
+				t.Errorf("bytes = %v to / %v from backend, want %d each",
+					closed["bytes_to_backend"], closed["bytes_from_backend"], total)
+			}
+
+			if tc.skipHandshake {
+				// the handshake entry is written after the stream close one
+				time.Sleep(time.Second)
+				if e := findLogEntry(readLogEntries(t, logPath), isHandshakeEntry); e != nil {
+					t.Errorf("handshake was logged despite skip_handshake: %v", e)
+				}
+			} else {
+				waitForLogEntry(t, logPath, isHandshakeEntry)
+			}
+		})
+	}
+}
