+			c, resp := dialWS(t, "/ws", map[string]string{"Accept-Encoding": "gzip"})
+			if ce := resp.Header.Get("Content-Encoding"); ce != "" {
+				t.Errorf("101 response was encoded: Content-Encoding %q", ce)
+			}
+			c.echo(t, "through encode")
+			c.echo(t, "still through encode")
