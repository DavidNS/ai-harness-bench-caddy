+func TestStreamCountedBytes(t *testing.T) {
+	settleStreams(t)
+	toBefore, fromBefore := streamBytes(t, streamDirToBackend), streamBytes(t, streamDirFromBackend)
+
+	st := newStream("upstream")
+	defer st.finish(streamResultCompleted)
+
+	var toBuf, fromBuf bytes.Buffer
+	if _, err := io.WriteString(st.counted(&toBuf, streamDirToBackend), "12345"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.WriteString(st.counted(&fromBuf, streamDirFromBackend), "1234567"); err != nil {
+		t.Fatal(err)
+	}
+	if toBuf.String() != "12345" || fromBuf.String() != "1234567" {
+		t.Errorf("data not passed through: %q %q", toBuf.String(), fromBuf.String())
+	}
+	if st.toBackend.Load() != 5 || st.fromBackend.Load() != 7 {
+		t.Errorf("stream counted %d/%d bytes, want 5/7", st.toBackend.Load(), st.fromBackend.Load())
+	}
+	if got := streamBytes(t, streamDirToBackend) - toBefore; got != 5 {
+		t.Errorf("bytes to backend metric moved by %v, want 5", got)
+	}
+	if got := streamBytes(t, streamDirFromBackend) - fromBefore; got != 7 {
+		t.Errorf("bytes from backend metric moved by %v, want 7", got)
+	}
+
+	// without a stream the destination is used as is
+	var dst bytes.Buffer
+	var none *stream
+	if w := none.counted(&dst, streamDirToBackend); w != io.Writer(&dst) {
+		t.Errorf("nil stream wrapped the writer: %T", w)
+	}
+}
