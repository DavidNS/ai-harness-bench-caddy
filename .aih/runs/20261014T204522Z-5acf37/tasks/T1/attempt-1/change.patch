+// TestStreamMetricsAccountedOnce ends one stream through several paths at
+// the same time (the stream timeout, a config unload, the client hanging up)
+// and checks that it is counted once.
+func TestStreamMetricsAccountedOnce(t *testing.T) {
+	switch runtime.GOOS {
+	case "plan9", "js", "wasip1":
+		t.Skipf("not supported on %s", runtime.GOOS)
+	}
+	results := []string{streamResultCompleted, streamResultError, streamResultTimeout, streamResultClosed, streamResultUpstreamRemoved}
+
+	for round := 0; round < 5; round++ {
+		settleStreams(t)
+		before := make(map[string]float64)
+		for _, r := range results {
+			before[r] = streamsClosed(t, r)
+		}
+		durationBefore := streamMetricValue(t, "caddy_reverse_proxy_stream_duration_seconds", nil)
+		toBefore, fromBefore := streamBytes(t, streamDirToBackend), streamBytes(t, streamDirFromBackend)
+
+		h, cli, srv := upgradedStream(t, "foo", func(h *Handler) { h.StreamTimeout = caddy.Duration(30 * time.Millisecond) })
+		waitUntil(t, "stream to be active", func() bool { return streamsActive(t) == 1 })
+		if _, err := cli.Write([]byte("abc")); err != nil {
+			t.Fatal(err)
+		}
+		expectRead(t, srv, "abc")
+
+		var wg sync.WaitGroup
+		wg.Add(3)
+		go func() { defer wg.Done(); _ = h.Cleanup() }()
+		go func() { defer wg.Done(); _ = cli.Close() }()
+		go func() { defer wg.Done(); _ = srv.Close() }()
+		wg.Wait()
+
+		waitUntil(t, "stream to end", func() bool { return streamsActive(t) == 0 })
+		var total float64
+		for _, r := range results {
+			total += streamsClosed(t, r) - before[r]
+		}
+		if total != 1 {
+			t.Fatalf("round %d: stream counted %v times, want 1", round, total)
+		}
+		if got := streamMetricValue(t, "caddy_reverse_proxy_stream_duration_seconds", nil) - durationBefore; got != 1 {
+			t.Errorf("round %d: %v duration observations, want 1", round, got)
+		}
+		if got := streamBytes(t, streamDirToBackend) - toBefore; got != 3 {
+			t.Errorf("round %d: bytes to backend moved by %v, want 3", round, got)
+		}
+		if got := streamBytes(t, streamDirFromBackend) - fromBefore; got != 0 {
+			t.Errorf("round %d: bytes from backend moved by %v, want 0", round, got)
+		}
+	}
+}
