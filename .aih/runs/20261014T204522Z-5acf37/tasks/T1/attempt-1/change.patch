+func TestDetachedRegistryPrune(t *testing.T) {
+	settleStreams(t)
+	r := &streamRegistry{streams: make(map[*stream]struct{})}
+	var closed []string
+	results := make(map[string]string)
+	var all []*stream
+	add := func(name, upstream string) *stream {
+		st := newStream(upstream)
+		st.closeFn = func() { closed = append(closed, name) }
+		st.onFinish = func(result string, _ time.Duration, _, _ int64) { results[name] = result }
+		r.add(st)
+		all = append(all, st)
+		return st
+	}
+	add("a", "a:1")
+	add("b1", "b:1")
+	add("b2", "b:1")
+	gone := add("gone", "gone:1")
+	r.remove(gone) // a stream that ended on its own is no longer registered
+
+	removedBefore := streamsClosed(t, streamResultUpstreamRemoved)
+	n := r.prune(func(upstream string) bool { return upstream == "a:1" })
+	if n != 2 {
+		t.Errorf("pruned %d streams, want 2", n)
+	}
+	slices.Sort(closed)
+	if !slices.Equal(closed, []string{"b1", "b2"}) {
+		t.Errorf("closed streams %v, want [b1 b2]", closed)
+	}
+	if results["b1"] != streamResultUpstreamRemoved || results["b2"] != streamResultUpstreamRemoved {
+		t.Errorf("results %v, want upstream_removed for b1 and b2", results)
+	}
+	if _, ok := results["a"]; ok {
+		t.Error("stream on a retained upstream was closed")
+	}
+	if got := streamsClosed(t, streamResultUpstreamRemoved) - removedBefore; got != 2 {
+		t.Errorf("upstream_removed metric moved by %v, want 2", got)
+	}
+
+	// nothing left to prune once everything is retained
+	if n := r.prune(func(string) bool { return true }); n != 0 {
+		t.Errorf("pruned %d streams, want 0", n)
+	}
+
+	for _, st := range all {
+		st.finish(streamResultCompleted)
+	}
+}
