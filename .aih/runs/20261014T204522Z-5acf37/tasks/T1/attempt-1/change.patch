+			// regular responses are still encoded
+			req, _ := http.NewRequest(http.MethodGet, "http://localhost:9080/gen", nil)
+			req.Header.Set("Accept-Encoding", "gzip")
+			tester.AssertResponseCode(req, 200)
+		})
+	}
