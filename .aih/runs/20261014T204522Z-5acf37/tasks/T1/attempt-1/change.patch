+func waitConnectionsRegistered(t *testing.T, h *Handler) {
+	t.Helper()
+	waitUntil(t, "connections to be registered", func() bool {
+		h.connectionsMu.Lock()
+		defer h.connectionsMu.Unlock()
+		return len(h.connections) > 0
+	})
+}
