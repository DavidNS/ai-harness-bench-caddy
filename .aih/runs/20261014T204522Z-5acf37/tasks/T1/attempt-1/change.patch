+func TestDetachedStreamCleanup(t *testing.T) {
+	switch runtime.GOOS {
+	case "plan9", "js", "wasip1":
+		t.Skipf("not supported on %s", runtime.GOOS)
+	}
+
+	detached := func(h *Handler) { h.StreamDetached = true }
+
+	t.Run("survives while upstream is retained", func(t *testing.T) {
+		settleStreams(t)
+		removedBefore := streamsClosed(t, streamResultUpstreamRemoved)
+		h, cli, srv := upgradedStream(t, "foo", detached)
+		waitDetachedRegistered(t)
+		dial := h.Upstreams[0].Dial
+
+		// the upstream is in the pool twice: the old config and the new one
+		hosts.LoadOrStore(dial, new(Host))
+		hosts.LoadOrStore(dial, new(Host))
+		if err := h.Cleanup(); err != nil {
+			t.Fatal(err)
+		}
+
+		if _, err := cli.Write([]byte("still here")); err != nil {
+			t.Fatal(err)
+		}
+		expectRead(t, srv, "still here")
+		h.connectionsMu.Lock()
+		registered := len(h.connections)
+		h.connectionsMu.Unlock()
+		if registered != 0 {
+			t.Error("detached stream was registered with the handler")
+		}
+
+		// the new config drops the upstream
+		_, _ = hosts.Delete(dial)
+		detachedStreams.prune(upstreamRetained)
+		expectClosed(t, cli)
+		waitUntil(t, "stream to be closed", func() bool {
+			return streamsClosed(t, streamResultUpstreamRemoved) == removedBefore+1
+		})
+	})
+
+	for _, upgrade := range []string{"foo", "websocket"} {
+		t.Run("closed when upstream removed/"+upgrade, func(t *testing.T) {
+			settleStreams(t)
+			removedBefore := streamsClosed(t, streamResultUpstreamRemoved)
+			h, cli, _ := upgradedStream(t, upgrade, detached)
+			waitDetachedRegistered(t)
+			hosts.LoadOrStore(h.Upstreams[0].Dial, new(Host))
+
+			if err := h.Cleanup(); err != nil {
+				t.Fatal(err)
+			}
+
+			got := expectClosed(t, cli)
+			if upgrade == "websocket" {
+				if !bytes.HasPrefix(got, []byte{0x88, 0x02, 0x03, 0xe9}) {
+					t.Errorf("client did not get a close frame: %x", got)
+				}
+			} else if len(got) != 0 {
+				t.Errorf("unexpected data before close: %x", got)
+			}
+			waitUntil(t, "stream to be closed", func() bool {
+				return streamsClosed(t, streamResultUpstreamRemoved) == removedBefore+1
+			})
+		})
+	}
+}
