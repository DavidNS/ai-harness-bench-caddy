+// h2Client is a minimal HTTP/2 client speaking raw frames, since the
+// standard clients do not send extended CONNECT requests.
+type h2Client struct {
+	conn net.Conn
+	fr   *http2.Framer
+	dec  *hpack.Decoder
+}
+
+func dialH2(t *testing.T, port int) *h2Client {
+	t.Helper()
+	conn, err := tls.DialWithDialer(&net.Dialer{Timeout: 5 * time.Second}, "tcp", fmt.Sprintf("127.0.0.1:%d", port), &tls.Config{
+		InsecureSkipVerify: true, //nolint:gosec
+		ServerName:         "localhost",
+		NextProtos:         []string{"h2"},
+	})
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	if conn.ConnectionState().NegotiatedProtocol != "h2" {
+		t.Fatalf("negotiated %q, want h2", conn.ConnectionState().NegotiatedProtocol)
+	}
+	_ = conn.SetDeadline(time.Now().Add(15 * time.Second))
+
+	c := &h2Client{conn: conn, fr: http2.NewFramer(conn, conn), dec: hpack.NewDecoder(4096, nil)}
+	if _, err := io.WriteString(conn, http2.ClientPreface); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.fr.WriteSettings(); err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+// next returns the next frame, answering the connection-level frames
+// (settings, pings) that are not interesting to the test.
+func (c *h2Client) next(t *testing.T) http2.Frame {
+	t.Helper()
+	for {
+		f, err := c.fr.ReadFrame()
+		if err != nil {
+			t.Fatalf("reading frame: %v", err)
+		}
+		switch f := f.(type) {
+		case *http2.SettingsFrame:
+			if f.IsAck() {
+				continue
+			}
+			if v, ok := f.Value(http2.SettingID(8)); !ok || v != 1 {
+				t.Fatalf("server did not advertise SETTINGS_ENABLE_CONNECT_PROTOCOL (extended CONNECT)")
+			}
+			if err := c.fr.WriteSettingsAck(); err != nil {
+				t.Fatal(err)
+			}
+		case *http2.PingFrame:
+			if !f.IsAck() {
+				_ = c.fr.WritePing(true, f.Data)
+			}
+		case *http2.WindowUpdateFrame:
+		default:
+			return f
+		}
+	}
+}
+
+// The HTTP/2 server only offers extended CONNECT (RFC 8441) when the process
+// is started with this GODEBUG setting, so the test runs in a child process
+// that has it. The child uses its own admin and listening ports, since the
+// Caddy of this process may still hold the usual ones.
+const h2xconnectSetting = "http2xconnect=1"
+
+func TestExtendedConnectH2(t *testing.T) {
+	if !strings.Contains(os.Getenv("GODEBUG"), h2xconnectSetting) {
+		if testing.Short() {
+			t.Skip("integration test")
+		}
+		// not os.Args[0], which the in-process Caddy overwrites
+		self, err := os.Executable()
+		if err != nil {
+			t.Fatalf("finding the test binary: %v", err)
