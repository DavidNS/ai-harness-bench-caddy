+// TestStreamFinishOnce checks that a stream is accounted exactly once when
+// several close paths race to finish it.
+func TestStreamFinishOnce(t *testing.T) {
+	settleStreams(t)
+	durationBefore := streamMetricValue(t, "caddy_reverse_proxy_stream_duration_seconds", nil)
+	results := []string{streamResultCompleted, streamResultError, streamResultTimeout, streamResultClosed, streamResultUpstreamRemoved}
+	before := make(map[string]float64)
+	for _, r := range results {
+		before[r] = streamsClosed(t, r)
+	}
+
+	st := newStream("upstream")
+	if got := streamsActive(t); got != 1 {
+		t.Fatalf("active streams = %v, want 1", got)
+	}
+	var calls int
+	var callsMu sync.Mutex
+	st.onFinish = func(result string, duration time.Duration, toBackend, fromBackend int64) {
+		callsMu.Lock()
+		calls++
+		callsMu.Unlock()
+	}
+
+	var wg sync.WaitGroup
+	var firsts int
+	var firstsMu sync.Mutex
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if st.finish(results[i%len(results)]) {
+				firstsMu.Lock()
+				firsts++
+				firstsMu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+
+	if firsts != 1 {
+		t.Errorf("%d calls to finish reported being the first, want 1", firsts)
+	}
+	if calls != 1 {
+		t.Errorf("onFinish called %d times, want 1", calls)
+	}
+	if got := streamsActive(t); got != 0 {
+		t.Errorf("active streams = %v after finish, want 0", got)
+	}
+	if got := streamMetricValue(t, "caddy_reverse_proxy_stream_duration_seconds", nil); got != durationBefore+1 {
+		t.Errorf("duration observations = %v, want %v", got, durationBefore+1)
+	}
+	var total float64
+	for _, r := range results {
+		total += streamsClosed(t, r) - before[r]
+	}
+	if total != 1 {
+		t.Errorf("streams counted as closed = %v, want 1", total)
+	}
+
+	// a nil stream (a connection registered without one) is ignored
+	var none *stream
+	if none.finish(streamResultClosed) {
+		t.Error("finish on a nil stream reported being the first")
+	}
+}
