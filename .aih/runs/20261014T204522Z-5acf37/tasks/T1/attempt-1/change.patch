+// readLogEntries returns the JSON log entries written to path so far.
+func readLogEntries(t *testing.T, path string) []map[string]any {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		t.Fatalf("reading log: %v", err)
+	}
+	var entries []map[string]any
+	for _, line := range bytes.Split(data, []byte("\n")) {
+		if len(bytes.TrimSpace(line)) == 0 {
+			continue
+		}
+		var e map[string]any
+		if err := json.Unmarshal(line, &e); err != nil {
+			continue // not a JSON entry (partially written)
+		}
+		entries = append(entries, e)
+	}
+	return entries
+}
+
+func findLogEntry(entries []map[string]any, match func(e map[string]any) bool) map[string]any {
+	for _, e := range entries {
+		if match(e) {
+			return e
+		}
+	}
+	return nil
+}
+
+func isStreamClosedEntry(e map[string]any) bool { return e["msg"] == "stream closed" }
+
+func isHandshakeEntry(e map[string]any) bool {
+	req, _ := e["request"].(map[string]any)
+	return e["msg"] == "handled request" && req != nil && req["uri"] == "/ws"
+}
+
+func waitForLogEntry(t *testing.T, path string, match func(e map[string]any) bool) map[string]any {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for time.Now().Before(deadline) {
+		if e := findLogEntry(readLogEntries(t, path), match); e != nil {
+			return e
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	t.Fatalf("expected log entry not found; log has %v", readLogEntries(t, path))
+	return nil
+}
