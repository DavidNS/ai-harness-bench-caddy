+func TestUpgradedStreamResults(t *testing.T) {
+	switch runtime.GOOS {
+	case "plan9", "js", "wasip1":
+		t.Skipf("not supported on %s", runtime.GOOS)
+	}
+
+	t.Run("completed with bytes", func(t *testing.T) {
+		settleStreams(t)
+		completedBefore := streamsClosed(t, streamResultCompleted)
+		toBefore, fromBefore := streamBytes(t, streamDirToBackend), streamBytes(t, streamDirFromBackend)
+
+		_, cli, srv := upgradedStream(t, "foo", func(*Handler) {})
+		waitUntil(t, "stream to be active", func() bool { return streamsActive(t) == 1 })
+		if _, err := cli.Write([]byte("hello")); err != nil {
+			t.Fatal(err)
+		}
+		expectRead(t, srv, "hello")
+		if _, err := srv.Write([]byte("world!!")); err != nil {
+			t.Fatal(err)
+		}
+		expectRead(t, cli, "world!!")
+		_ = cli.CloseWrite()
+		_ = srv.CloseWrite()
+
+		waitUntil(t, "stream to complete", func() bool { return streamsActive(t) == 0 })
+		if got := streamsClosed(t, streamResultCompleted) - completedBefore; got != 1 {
+			t.Errorf("completed streams moved by %v, want 1", got)
+		}
+		if got := streamBytes(t, streamDirToBackend) - toBefore; got != 5 {
+			t.Errorf("bytes to backend moved by %v, want 5", got)
+		}
+		if got := streamBytes(t, streamDirFromBackend) - fromBefore; got != 7 {
+			t.Errorf("bytes from backend moved by %v, want 7", got)
+		}
+	})
+
+	t.Run("timeout", func(t *testing.T) {
+		settleStreams(t)
+		before := streamsClosed(t, streamResultTimeout)
+		_, cli, _ := upgradedStream(t, "foo", func(h *Handler) { h.StreamTimeout = caddy.Duration(50 * time.Millisecond) })
+		expectClosed(t, cli)
+		waitUntil(t, "stream to time out", func() bool { return streamsClosed(t, streamResultTimeout) == before+1 })
+	})
+
+	t.Run("closed by cleanup", func(t *testing.T) {
+		settleStreams(t)
+		before := streamsClosed(t, streamResultClosed)
+		h, cli, _ := upgradedStream(t, "foo", func(*Handler) {})
+		waitConnectionsRegistered(t, h)
+		if err := h.Cleanup(); err != nil {
+			t.Fatal(err)
+		}
+		expectClosed(t, cli)
+		waitUntil(t, "stream to be closed", func() bool { return streamsClosed(t, streamResultClosed) == before+1 })
+	})
+}
