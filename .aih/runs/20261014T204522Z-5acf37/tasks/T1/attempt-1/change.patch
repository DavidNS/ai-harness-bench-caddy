+func TestRegisterStreamMetrics(t *testing.T) {
+	// registering twice with the same registry is fine
+	core, logs := observer.New(zapcore.DebugLevel)
+	reg := prometheus.NewRegistry()
+	registerStreamMetrics(reg, zap.New(core))
+	registerStreamMetrics(reg, zap.New(core))
+	if logs.Len() != 0 {
+		t.Errorf("unexpected logs registering twice: %v", logs.All())
+	}
+
+	// a clashing collector is logged and does not keep the others from registering
+	reg = prometheus.NewRegistry()
+	clash := prometheus.NewGauge(prometheus.GaugeOpts{
+		Namespace: "caddy", Subsystem: "reverse_proxy", Name: "streams_active", Help: "something else",
+	})
+	if err := reg.Register(clash); err != nil {
+		t.Fatal(err)
+	}
+	registerStreamMetrics(reg, zap.New(core))
+	if logs.Len() != 1 {
+		t.Errorf("expected 1 log for the clashing collector, got %v", logs.All())
+	}
+	mfs, err := reg.Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, mf := range mfs {
+		names = append(names, mf.GetName())
+	}
+	if !slices.Contains(names, "caddy_reverse_proxy_stream_bytes_total") {
+		t.Errorf("remaining collectors not registered: %v", names)
