+// The client sees the upgrade before the proxy has registered the stream.
+func waitDetachedRegistered(t *testing.T) {
+	t.Helper()
+	waitUntil(t, "stream to be registered", func() bool {
+		detachedStreams.mu.Lock()
+		defer detachedStreams.mu.Unlock()
+		return len(detachedStreams.streams) > 0
+	})
+}
