+
+func TestInitReverseProxyMetricsRegistersStreamMetrics(t *testing.T) {
+	h := &Handler{logger: zap.NewNop()}
+	registry := prometheus.NewRegistry()
+	initReverseProxyMetrics(h, registry)
+	// registering again is tolerated
+	initReverseProxyMetrics(h, registry)
